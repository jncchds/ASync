<Project>
  <!-- Central package versions: every .csproj references packages without a Version attribute. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Versions below also win for transitive dependencies (e.g. Npgsql's EF Core Relational), avoiding MSB3277. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Server -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <!-- Clients -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <!-- The agent as a service: systemd (Type=notify, journald), Windows Service (Event Log); DPAPI for the store on Windows -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <!-- The Avalonia app (src/ASync.App, src/ASync.App.Desktop) -->
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Android" Version="12.1.6" />
    <!-- The Android app's QR scanner: a pure .NET decoder over the camera's preview frames (no Google Play services) -->
    <PackageVersion Include="ZXing.Net" Version="0.16.10" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Installers and self-update of the desktop app (Setup.exe, the macOS package, the AppImage); vpk 1.2.161 in .config/dotnet-tools.json -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <!-- Storage back-ends -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.12" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="SMBLibrary" Version="1.5.8.1" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <!-- The app's tests (src/ASync.App.Tests) run on xunit v3, which Avalonia.Headless.XUnit 12 needs -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- CI: failed tests as annotations and a job summary (the GitHubActions test logger) -->
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
  </ItemGroup>
</Project>
