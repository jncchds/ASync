<!--
  The family look of the web UI's components (index.css): flat cards, pills, primary/secondary/danger/link buttons,
  muted text, notices. Class names follow the CSS (.card, .pill.success, Button.secondary, TextBlock.muted).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector=":is(TopLevel)">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="UserControl">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- ── Text ── -->
  <Style Selector="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource Success}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, DejaVu Sans Mono, Menlo, Consolas, monospace" />
  </Style>
  <Style Selector="TextBlock.code">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- ── Cards, notices ── -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{DynamicResource WarningFaint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.notice.danger">
    <Setter Property="Background" Value="{DynamicResource DangerFaint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerLine}" />
  </Style>
  <Style Selector="Border.notice.info">
    <Setter Property="Background" Value="{DynamicResource AccentFaint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentSoft}" />
  </Style>

  <!-- ── Pills ── -->
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource MutedFaint}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="Border.pill.accent">
    <Setter Property="Background" Value="{DynamicResource AccentFaint}" />
  </Style>
  <Style Selector="Border.pill.accent > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.pill.success">
    <Setter Property="Background" Value="{DynamicResource SuccessFaint}" />
  </Style>
  <Style Selector="Border.pill.success > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Success}" />
  </Style>
  <Style Selector="Border.pill.warning">
    <Setter Property="Background" Value="{DynamicResource WarningFaint}" />
  </Style>
  <Style Selector="Border.pill.warning > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
  </Style>
  <Style Selector="Border.pill.danger">
    <Setter Property="Background" Value="{DynamicResource DangerFaint}" />
  </Style>
  <Style Selector="Border.pill.danger > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>

  <!-- ── Buttons: primary by default, .secondary, .danger, .small, .link ── -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentContrast}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentContrast}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentContrast}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentContrast}" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFaint}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerFaint}" />
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerLine}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentContrast}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>

  <Style Selector="Button.small">
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFaint}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <!-- ── Inputs ── -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource MutedFaint}" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>

  <!-- A choice between two ways (code / approve in the browser), like the web UI's type picker. -->
  <Style Selector="RadioButton.choice">
    <Setter Property="Padding" Value="8,4" />
  </Style>
</Styles>
