<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ASync.App.ViewModels"
             xmlns:svc="using:ASync.App.Services"
             xmlns:sys="using:System"
             x:Class="ASync.App.Views.LocalFolderView"
             x:DataType="vm:LocalFolderViewModel">
  <UserControl.Styles>
    <!-- A folder row: the page's text colour, not the primary button's (white on the light theme's white). -->
    <Style Selector="Button.entry">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.entry:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentFaint}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Button.entry:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <!-- Without All files access: one short screen on why, the system page, or the system picker instead. -->
    <Border Classes="card" Name="Explanation" IsVisible="{Binding IsExplaining}" VerticalAlignment="Center" BoxShadow="0 8 32 0 #40000000">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Allow all files access?" TextWrapping="Wrap" />
        <TextBlock Text="{x:Static vm:LocalFolderViewModel.Explanation}" TextWrapping="Wrap" />
        <TextBlock Classes="muted small" Text="{x:Static vm:LocalFolderViewModel.FallbackNote}" TextWrapping="Wrap" />
        <Border Classes="notice" IsVisible="{Binding StillOff}">
          <TextBlock Classes="small" Name="StillOff" TextWrapping="Wrap"
                     Text="All files access is still off. Turn on &quot;Allow access to manage all files&quot; for ASync, or use the system picker." />
        </Border>
        <StackPanel Spacing="8">
          <Button Name="AllowAllFiles" Content="Allow all files access" Command="{Binding AllowAccessCommand}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" />
          <Button Classes="secondary" Name="UseSystemPicker" Content="Use the system picker" Command="{Binding UseSystemPickerCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Classes="link" Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- With it: the folders on the phone's volumes. -->
    <Border Classes="card" Name="Picker" IsVisible="{Binding IsPicking}" BoxShadow="0 8 32 0 #40000000" Padding="14">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Volumes}" Margin="0,0,0,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="svc:StorageVolumeInfo">
              <Button Classes="small secondary" Content="{Binding Label}"
                      Command="{Binding $parent[ItemsControl].((vm:LocalFolderViewModel)DataContext).SelectVolumeCommand}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,0,0,6">
          <Button Classes="small secondary" Name="Up" Content="↑ Up" Command="{Binding UpCommand}" Margin="0,0,8,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Name="Breadcrumb" Text="{Binding Breadcrumb}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="muted small mono" Name="CurrentPath" Text="{Binding CurrentPath}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" MinHeight="120">
          <Panel>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl Name="Entries" ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="sys:String">
                    <Button Classes="entry" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10"
                            Background="Transparent" CornerRadius="0"
                            Command="{Binding $parent[ItemsControl].((vm:LocalFolderViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="📁" />
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Classes="muted small" Text="No folders in here." IsVisible="{Binding IsEmpty}" Margin="12" />
          </Panel>
        </Border>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <TextBox Name="NewFolderName" Text="{Binding NewFolderName}" PlaceholderText="New folder here" />
          <Button Grid.Column="1" Classes="small secondary" Content="Create" Command="{Binding CreateFolderCommand}" Margin="6,0,0,0" />
        </Grid>

        <Border Grid.Row="5" Classes="notice danger" IsVisible="{Binding HasError}" Margin="0,8,0,0">
          <TextBlock Name="PickerError" Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Grid.Row="6" Classes="muted small" Text="{x:Static vm:LocalFolderViewModel.UnreachableNote}" TextWrapping="Wrap" Margin="0,8,0,0" />

        <WrapPanel Grid.Row="7" ItemSpacing="8" LineSpacing="8" Margin="0,10,0,0">
          <Button Name="UseThisFolder" Content="Use this folder" Command="{Binding UseThisFolderCommand}" />
          <Button Classes="secondary" Content="Cancel" Command="{Binding CancelCommand}" />
          <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding Busy}" VerticalAlignment="Center" />
        </WrapPanel>
      </Grid>
    </Border>
  </Panel>
</UserControl>
