<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ASync.App.ViewModels"
             x:Class="ASync.App.Views.EnrollView"
             x:DataType="vm:EnrollViewModel">
  <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Stretch">
    <StackPanel Spacing="4" Margin="2,8,0,4">
      <TextBlock Classes="h1" Text="Add this device" />
      <TextBlock Classes="muted" Text="Connect this computer to your ASync server. Its folders are set up in the web UI afterwards." />
    </StackPanel>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <StackPanel>
          <TextBlock Classes="label" Text="Server address" />
          <TextBox Name="Server" Text="{Binding Server}" PlaceholderText="https://sync.example.com" IsEnabled="{Binding IsNotWaiting}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Device name" />
          <TextBox Name="DeviceName" Text="{Binding DeviceName}" IsEnabled="{Binding IsNotWaiting}" />
        </StackPanel>

        <WrapPanel ItemSpacing="16" LineSpacing="4" IsVisible="{Binding IsNotWaiting}">
          <RadioButton Classes="choice" GroupName="method" Name="UseCode" Content="I have a code" IsChecked="{Binding UseCode}" />
          <RadioButton Classes="choice" GroupName="method" Name="UseDeviceCode" Content="Approve in the browser" IsChecked="{Binding UseDeviceCode}" />
        </WrapPanel>

        <!-- A code from Devices → Add device (or the pairing link of its QR code). -->
        <StackPanel Spacing="10" IsVisible="{Binding UseCode}">
          <StackPanel>
            <TextBlock Classes="label" Text="Code from the web UI (Devices → Add device)" />
            <TextBox Name="Code" Text="{Binding Code}" PlaceholderText="K7QD-M2XP-9RWA" FontSize="16" />
            <TextBlock Classes="muted small" Margin="0,4,0,0" Text="Pasting the async://pair link of the QR code fills in the server too." />
          </StackPanel>
          <Button Name="Enroll" Content="Add this device" Command="{Binding EnrollCommand}" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- The device-code flow: start, show the code, wait. -->
        <StackPanel Spacing="10" IsVisible="{Binding UseDeviceCode}">
          <StackPanel Spacing="10" IsVisible="{Binding IsNotWaiting}">
            <TextBlock Classes="muted" Text="The browser opens the server's approval page; sign in there and approve this device." />
            <Button Name="StartDeviceCode" Content="Get a code" Command="{Binding StartDeviceCodeCommand}" HorizontalAlignment="Left" />
          </StackPanel>
          <Border Classes="notice info" IsVisible="{Binding IsWaiting}">
            <StackPanel Spacing="8">
              <TextBlock Text="Check that the approval page shows this code, then approve it:" />
              <TextBlock Classes="code" Name="UserCode" Text="{Binding Pending.UserCode}" />
              <TextBlock Classes="muted small" Text="{Binding ExpiresText}" />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Classes="small" Content="Open the approval page" Command="{Binding OpenApprovalLinkCommand}" />
                <Button Classes="small secondary" Content="Cancel" Command="{Binding CancelPendingCommand}" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" />
                <TextBlock Classes="muted small" Text="Waiting for approval…" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Classes="notice danger" IsVisible="{Binding HasError}">
          <TextBlock Name="Error" Text="{Binding Error}" />
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
