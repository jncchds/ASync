<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ASync.App.ViewModels"
             xmlns:svc="using:ASync.App.Services"
             x:Class="ASync.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,0">
      <TextBlock Classes="h1" Text="Settings" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="secondary" Name="CloseSettings" Content="Done" Command="{Binding CloseCommand}" />
    </Grid>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="This app" />
        <CheckBox Name="StartAtLogin" Content="Start ASync when I log in" IsChecked="{Binding StartAtLogin}" IsVisible="{Binding SupportsStartAtLogin}" />
        <CheckBox Name="Notifications" Content="Notify me when a folder fails to sync or has conflicts" IsChecked="{Binding Notifications}" />
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="Theme" />
          <WrapPanel ItemSpacing="16" LineSpacing="4">
            <RadioButton GroupName="theme" Name="ThemeLight" Content="Light" IsChecked="{Binding IsLightTheme}" />
            <RadioButton GroupName="theme" Name="ThemeDark" Content="Dark" IsChecked="{Binding IsDarkTheme}" />
            <RadioButton GroupName="theme" Name="ThemeSystem" Content="Same as the system" IsChecked="{Binding IsSystemTheme}" />
          </WrapPanel>
        </StackPanel>
        <Border Classes="notice danger" IsVisible="{Binding HasError}">
          <TextBlock Text="{Binding Error}" />
        </Border>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="This device" />
        <TextBlock Text="{Binding DeviceText}" IsVisible="{Binding CanSignOut}" />
        <TextBlock Classes="muted" Text="Not enrolled." IsVisible="{Binding !CanSignOut}" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Classes="secondary" Content="Open the web UI" Command="{Binding OpenWebUiCommand}" IsVisible="{Binding OffersWebUi}" />
          <Button Classes="danger" Name="SignOut" Content="Sign out of this device…" Command="{Binding SignOutCommand}"
                  IsVisible="{Binding CanSignOut}" IsEnabled="{Binding !ConfirmingSignOut}" />
        </WrapPanel>
        <Border Classes="notice danger" IsVisible="{Binding ConfirmingSignOut}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding SignOutText}" TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="danger" Name="ConfirmSignOut" Content="Sign out" Command="{Binding ConfirmSignOutCommand}" />
              <Button Classes="secondary" Content="Keep it" Command="{Binding CancelSignOutCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Classes="card" Name="StorageCard" IsVisible="{Binding HasStorage}">
      <StackPanel Spacing="8">
        <TextBlock Classes="h2" Text="Folders on this phone" />
        <WrapPanel ItemSpacing="8" LineSpacing="4">
          <TextBlock Classes="label" Text="All files access" VerticalAlignment="Center" />
          <Border Classes="pill success" IsVisible="{Binding Storage.HasAllFilesAccess, FallbackValue=False}"><TextBlock Text="Allowed" /></Border>
          <Border Classes="pill warning" IsVisible="{Binding !Storage.HasAllFilesAccess, FallbackValue=False}"><TextBlock Text="Not allowed" /></Border>
        </WrapPanel>
        <TextBlock Name="StorageText" Text="{Binding Storage.StatusText, FallbackValue=''}" TextWrapping="Wrap" />
        <Button Name="ChangeAllFilesAccess" Content="{Binding Storage.ChangeText, FallbackValue=''}" Command="{Binding Storage.ChangeCommand, FallbackValue={x:Null}}"
                HorizontalAlignment="Left" />
        <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{x:Static vm:StorageViewModel.UnreachableNote}" />
        <TextBlock Classes="muted small" TextWrapping="Wrap"
                   Text="Turned off later, folders at real paths stop with a message (nothing is deleted anywhere) until it is on again or they are chosen with the system picker." />
      </StackPanel>
    </Border>

    <Border Classes="card" Name="BackgroundCard" IsVisible="{Binding HasBackground}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Background sync" />
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="Battery" />
          <TextBlock Name="BatteryText" Text="{Binding Background.BatteryText, FallbackValue=''}" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Name="AllowBattery" Content="Allow background sync" Command="{Binding Background.AllowBatteryCommand, FallbackValue={x:Null}}"
                    IsVisible="{Binding !Background.BatteryUnrestricted, FallbackValue=False}" />
            <Button Classes="secondary" Content="Battery settings" Command="{Binding Background.OpenBatterySettingsCommand, FallbackValue={x:Null}}" />
          </WrapPanel>
          <TextBlock Classes="muted small" Name="VendorHint" Text="{Binding Background.VendorHint, FallbackValue=''}" TextWrapping="Wrap"
                     IsVisible="{Binding Background.HasVendorHint, FallbackValue=False}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="Wake-ups (UnifiedPush)" />
          <TextBlock Classes="muted small" Text="{x:Static vm:BackgroundViewModel.PushExplanation}" TextWrapping="Wrap" />
          <TextBlock Name="PushText" Text="{Binding Background.PushText, FallbackValue=''}" TextWrapping="Wrap"
                     Classes.error="{Binding Background.PushProblem, FallbackValue=False}" />
          <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding Background.HasDistributors, FallbackValue=False}">
            <ComboBox Name="Distributor" ItemsSource="{Binding Background.Distributors, FallbackValue={x:Null}}"
                      SelectedItem="{Binding Background.SelectedDistributor, FallbackValue={x:Null}}" MinWidth="160">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="svc:PushDistributor"><TextBlock Text="{Binding Name}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Name="RegisterPush" Content="Use for wake-ups" Command="{Binding Background.RegisterPushCommand, FallbackValue={x:Null}}" />
            <Button Classes="secondary" Name="UnregisterPush" Content="Turn off" Command="{Binding Background.UnregisterPushCommand, FallbackValue={x:Null}}"
                    IsVisible="{Binding Background.PushActive, FallbackValue=False}" />
          </WrapPanel>
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="Remind me when nothing synced for" />
          <ComboBox Name="ReminderDays" ItemsSource="{Binding Background.ReminderOptions, FallbackValue={x:Null}}"
                    SelectedIndex="{Binding Background.ReminderIndex, FallbackValue=0}" MinWidth="160" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="A notification from the phone itself, moved on after every successful run: it needs neither the server nor push." />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Updates" />
        <CheckBox Name="CheckForUpdates" Content="Check for new versions automatically" IsChecked="{Binding CheckForUpdates}"
                  IsVisible="{Binding Updates.IsSupported}" />
        <TextBlock Name="UpdateStatus" Classes="muted" Text="{Binding Updates.StatusText}" TextWrapping="Wrap" />
        <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding Updates.IsSupported}">
          <Button Classes="secondary" Name="CheckUpdatesNow" Content="Check now" Command="{Binding Updates.CheckNowCommand}"
                  IsEnabled="{Binding Updates.CanCheck}" />
          <Button Name="InstallUpdateFromSettings" Content="Install and restart" Command="{Binding Updates.InstallCommand}"
                  IsVisible="{Binding Updates.CanInstall}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Classes="h2" Text="About" />
        <TextBlock Name="AppVersion" Text="{Binding AppText}" />
        <TextBlock Classes="muted" Text="{Binding AgentText}" />
        <TextBlock Classes="muted small" Text="Self-hosted sync and backup. MIT licence." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
