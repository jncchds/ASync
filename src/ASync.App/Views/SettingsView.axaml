<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ASync.App.ViewModels"
             x:Class="ASync.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,0">
      <TextBlock Classes="h1" Text="Settings" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="secondary" Name="CloseSettings" Content="Done" Command="{Binding CloseCommand}" />
    </Grid>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="This app" />
        <CheckBox Name="StartAtLogin" Content="Start ASync when I log in" IsChecked="{Binding StartAtLogin}" IsVisible="{Binding SupportsStartAtLogin}" />
        <CheckBox Name="Notifications" Content="Notify me when a folder fails to sync or has conflicts" IsChecked="{Binding Notifications}" />
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="Theme" />
          <WrapPanel ItemSpacing="16" LineSpacing="4">
            <RadioButton GroupName="theme" Name="ThemeLight" Content="Light" IsChecked="{Binding IsLightTheme}" />
            <RadioButton GroupName="theme" Name="ThemeDark" Content="Dark" IsChecked="{Binding IsDarkTheme}" />
            <RadioButton GroupName="theme" Name="ThemeSystem" Content="Same as the system" IsChecked="{Binding IsSystemTheme}" />
          </WrapPanel>
        </StackPanel>
        <Border Classes="notice danger" IsVisible="{Binding HasError}">
          <TextBlock Text="{Binding Error}" />
        </Border>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="This device" />
        <TextBlock Text="{Binding DeviceText}" IsVisible="{Binding CanSignOut}" />
        <TextBlock Classes="muted" Text="Not enrolled." IsVisible="{Binding !CanSignOut}" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Classes="secondary" Content="Open the web UI" Command="{Binding OpenWebUiCommand}" />
          <Button Classes="danger" Name="SignOut" Content="Sign out of this device…" Command="{Binding SignOutCommand}"
                  IsVisible="{Binding CanSignOut}" IsEnabled="{Binding !ConfirmingSignOut}" />
        </WrapPanel>
        <Border Classes="notice danger" IsVisible="{Binding ConfirmingSignOut}">
          <StackPanel Spacing="8">
            <TextBlock Text="Sign out of this device? It stops syncing and forgets its identity here. Your files stay where they are. Remove the device in the web UI too; to use it again, enroll it again." />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="danger" Name="ConfirmSignOut" Content="Sign out" Command="{Binding ConfirmSignOutCommand}" />
              <Button Classes="secondary" Content="Keep it" Command="{Binding CancelSignOutCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Updates" />
        <CheckBox Name="CheckForUpdates" Content="Check for new versions automatically" IsChecked="{Binding CheckForUpdates}"
                  IsVisible="{Binding Updates.IsSupported}" />
        <TextBlock Name="UpdateStatus" Classes="muted" Text="{Binding Updates.StatusText}" TextWrapping="Wrap" />
        <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding Updates.IsSupported}">
          <Button Classes="secondary" Name="CheckUpdatesNow" Content="Check now" Command="{Binding Updates.CheckNowCommand}"
                  IsEnabled="{Binding Updates.CanCheck}" />
          <Button Name="InstallUpdateFromSettings" Content="Install and restart" Command="{Binding Updates.InstallCommand}"
                  IsVisible="{Binding Updates.CanInstall}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Classes="h2" Text="About" />
        <TextBlock Name="AppVersion" Text="{Binding AppText}" />
        <TextBlock Classes="muted" Text="{Binding AgentText}" />
        <TextBlock Classes="muted small" Text="Self-hosted sync and backup. MIT licence." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
