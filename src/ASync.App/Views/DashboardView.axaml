<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ASync.App.ViewModels"
             x:Class="ASync.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <StackPanel Spacing="12">
    <!-- Phones: Android's battery optimisation holds background work back (dismissable). -->
    <Border Classes="card" Name="BatteryPrompt" IsVisible="{Binding Shell.Background.ShowBatteryPrompt, FallbackValue=False}">
      <StackPanel Spacing="8">
        <TextBlock Text="Let ASync sync in the background" FontWeight="SemiBold" />
        <TextBlock Classes="muted" Text="{x:Static vm:BackgroundViewModel.BatteryExplanation}" TextWrapping="Wrap" />
        <TextBlock Classes="muted small" Text="{Binding Shell.Background.VendorHint, FallbackValue=''}" TextWrapping="Wrap"
                   IsVisible="{Binding Shell.Background.HasVendorHint, FallbackValue=False}" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Name="AllowBackground" Content="Allow" Command="{Binding Shell.Background.AllowBatteryCommand, FallbackValue={x:Null}}" />
          <Button Classes="secondary" Name="NotNow" Content="Not now" Command="{Binding Shell.Background.DismissBatteryPromptCommand, FallbackValue={x:Null}}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- This device and its server. -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel ItemSpacing="8" LineSpacing="4">
          <TextBlock Classes="h1" Name="DeviceName" Text="{Binding DeviceName}" />
          <Border Classes="pill" Classes.success="{Binding State.IsSuccess}" Classes.warning="{Binding State.IsWarning}"
                  Classes.danger="{Binding State.IsDanger}">
            <TextBlock Name="ConnectionState" Text="{Binding State.Text}" />
          </Border>
        </WrapPanel>
        <TextBlock Classes="muted">
          <Run Text="{Binding Account}" /><Run Text=" on " /><Run Text="{Binding ServerUrl}" />
        </TextBlock>
        <Border Classes="notice danger" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding Problem}" />
        </Border>
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Name="SyncAll" Content="Sync all now" Command="{Binding Shell.SyncAllCommand}" />
          <Button Classes="secondary" Name="PauseAll" Content="{Binding Shell.PauseAllText}" Command="{Binding Shell.PauseAllCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,Auto" Margin="2,6,0,0">
      <TextBlock Classes="h2" Text="Folders" VerticalAlignment="Center" />
      <WrapPanel Grid.Column="1" ItemSpacing="6" LineSpacing="6" HorizontalAlignment="Right">
        <Button Classes="small" Name="NewFolder" Content="New folder…" Command="{Binding Shell.NewFolderCommand}" />
        <Button Classes="small secondary" Name="JoinFolder" Content="Add to a folder…" Command="{Binding Shell.JoinFolderCommand}"
                ToolTip.Tip="Add this device to one of your folders" />
      </WrapPanel>
    </Grid>
    <Border Classes="card" IsVisible="{Binding HasNoFolders}">
      <StackPanel Spacing="6">
        <TextBlock Text="No folders on this device yet." FontWeight="SemiBold" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding NoFoldersHint}" />
        <Button Classes="secondary" Content="Open the web UI" Command="{Binding Shell.OpenWebUiCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                IsVisible="{Binding Shell.OffersWebUi}" />
      </StackPanel>
    </Border>

    <ItemsControl Name="FolderList" ItemsSource="{Binding Folders}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:FolderViewModel">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <WrapPanel ItemSpacing="6" LineSpacing="4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15.5" Margin="0,0,4,0" />
                <Border Classes="pill" Classes.success="{Binding State.IsSuccess}" Classes.warning="{Binding State.IsWarning}"
                        Classes.danger="{Binding State.IsDanger}" Classes.accent="{Binding State.IsAccent}">
                  <TextBlock Text="{Binding State.Text}" />
                </Border>
                <Border Classes="pill"><TextBlock Text="{Binding ModeText}" /></Border>
                <Border Classes="pill accent" IsVisible="{Binding IsEndToEnd}"><TextBlock Text="🔒 End-to-end" /></Border>
              </WrapPanel>

              <TextBlock Classes="muted small mono" Text="{Binding LocalPath}" TextWrapping="Wrap" />
              <TextBlock Classes="muted small" Name="MediaCounts" Text="{Binding MediaCountsText}" TextWrapping="Wrap"
                         IsVisible="{Binding MediaCountsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Border Classes="notice" Name="PhotoAccess" IsVisible="{Binding PhotoAccessText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="small" Text="{Binding PhotoAccessText}" TextWrapping="Wrap" />
              </Border>
              <Border Classes="notice" Name="RestoreChoice" IsVisible="{Binding ChoosingRestore}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="small" FontWeight="SemiBold" Text="Restore which snapshot into the library?" TextWrapping="Wrap" />
                  <ComboBox Name="RestoreSnapshots" ItemsSource="{Binding RestoreChoices}" SelectedItem="{Binding SelectedRestore}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:RestoreChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Classes="muted small" TextWrapping="Wrap"
                             Text="Photos still on the phone are skipped. An older snapshot brings back what was deleted since." />
                  <WrapPanel ItemSpacing="6" LineSpacing="6">
                    <Button Classes="small" Name="ConfirmRestore" Content="Restore" Command="{Binding ConfirmRestoreCommand}" />
                    <Button Classes="small secondary" Content="Cancel" Command="{Binding CancelRestoreCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <StackPanel Spacing="4" Name="Restore" IsVisible="{Binding RestoreText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ProgressBar Value="{Binding RestorePercent}" Maximum="100" IsVisible="{Binding RestoreRunning}" />
                <TextBlock Classes="muted small" Text="{Binding RestoreText}" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
                <ProgressBar Value="{Binding ProgressPercent}" IsIndeterminate="{Binding IsProgressIndeterminate}" Maximum="100" />
                <TextBlock Classes="muted small" Text="{Binding ProgressText}" />
                <TextBlock Classes="muted small" Text="{Binding CurrentFile}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           IsVisible="{Binding CurrentFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>

              <TextBlock Classes="small" Classes.error="{Binding !LastResultOk}" Classes.muted="{Binding LastResultOk}">
                <Run Text="{Binding LastRunText}" /><Run Text=" · " /><Run Text="{Binding LastResultText}" />
              </TextBlock>
              <TextBlock Classes="muted small" Text="{Binding NextRunText}" />
              <TextBlock Classes="muted small" Text="{Binding ConditionsText}" TextWrapping="Wrap"
                         IsVisible="{Binding ConditionsText, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <Border Classes="notice" IsVisible="{Binding EditingConditions}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="small" FontWeight="SemiBold" Text="Run by itself only" />
                  <CheckBox Name="UnmeteredOnly" Content="On Wi-Fi (not on mobile data or a metered hotspot)" IsChecked="{Binding EditUnmeteredOnly}" />
                  <CheckBox Name="ChargingOnly" Content="While charging" IsChecked="{Binding EditChargingOnly}" />
                  <CheckBox Name="BatteryNotLow" Content="When the battery is not low" IsChecked="{Binding EditBatteryNotLow}" />
                  <TextBlock Classes="muted small" TextWrapping="Wrap"
                             Text="Scheduled runs, changes and wake-ups wait for these. Sync now runs at once." />
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding ConditionsNote}" IsVisible="{Binding HasConditionsNote}" />
                  <WrapPanel ItemSpacing="6" LineSpacing="6">
                    <Button Classes="small" Name="SaveConditions" Content="Save" Command="{Binding SaveConditionsCommand}" />
                    <Button Classes="small secondary" Content="Cancel" Command="{Binding CancelConditionsCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Classes="notice" IsVisible="{Binding AlertText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="small" Text="{Binding AlertText}" />
              </Border>
              <Border Classes="notice" IsVisible="{Binding CanBeUnlocked}">
                <TextBlock Classes="small" TextWrapping="Wrap" Text="End-to-end encrypted and locked on this device: unlock it with the passphrase or the recovery key to back it up here." />
              </Border>
              <Border Classes="notice" IsVisible="{Binding NeedsSetup}">
                <TextBlock Classes="small" TextWrapping="Wrap" Text="End-to-end encrypted and not set up yet: choose its passphrase here (you get its recovery key once). Other devices then unlock it with the same passphrase." />
              </Border>

              <Border Classes="notice" Name="RealPathOffer" IsVisible="{Binding CanSwitchToRealPath}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="small" TextWrapping="Wrap"
                             Text="With All files access this folder can use its real path: faster, and files that changed are noticed. Its sync state is kept: nothing is uploaded again." />
                  <Button Classes="small" Name="SwitchToRealPath" Content="{Binding SwitchText}" Command="{Binding SwitchToRealPathCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <WrapPanel ItemSpacing="6" LineSpacing="6" Margin="0,2,0,0">
                <Button Classes="small" Content="Unlock…" Command="{Binding UnlockCommand}" IsVisible="{Binding CanBeUnlocked}" />
                <Button Classes="small" Name="SetUpEncryption" Content="Set up encryption…" Command="{Binding SetUpEncryptionCommand}" IsVisible="{Binding NeedsSetup}" />
                <Button Classes="small" Content="Choose folder…" Command="{Binding ChooseFolderCommand}" IsVisible="{Binding NeedsPath}" />
                <Button Classes="small" Content="{Binding RunNowText}" Command="{Binding SyncNowCommand}" IsVisible="{Binding CanRunHere}" />
                <Button Classes="small secondary" Content="{Binding PauseText}" Command="{Binding TogglePauseCommand}" />
                <Button Classes="small secondary" Content="Open folder" Command="{Binding OpenFolderCommand}" IsVisible="{Binding ShowFolderButtons}" />
                <Button Classes="small secondary" Content="Change folder…" Command="{Binding ChooseFolderCommand}" IsVisible="{Binding ShowFolderButtons}" />
                <Button Classes="small secondary" Name="ChoosePhotos" Content="Photos…" Command="{Binding ChoosePhotosCommand}" IsVisible="{Binding IsPhotos}" />
                <Button Classes="small secondary" Name="RestorePhotos" Content="Restore into the library…" Command="{Binding RestorePhotosCommand}"
                        IsVisible="{Binding IsPhotos}" />
                <Button Classes="small secondary" Name="EditConditions" Content="Conditions…" Command="{Binding EditConditionsCommand}"
                        IsVisible="{Binding !EditingConditions}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
