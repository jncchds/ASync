<?xml version="1.0" encoding="utf-8"?>
<!-- The rest (application, activities, the async://pair intent filter, the automation and push receivers) comes from the attributes in code. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Only for scanning the web UI's QR code; the app works without a camera. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera.any" android:required="false" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Background work (M4-2): WorkManager's foreground service while transfers run (type dataSync), and the system's
       question whether ASync may ignore battery optimisation (an APK outside Google Play may ask). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- Android 11+ package visibility: find installed UnifiedPush distributors (ntfy, …). -->
  <queries>
    <intent>
      <action android:name="org.unifiedpush.android.distributor.REGISTER" />
    </intent>
  </queries>
  <application>
    <!-- WorkManager's own foreground service, declared with the type Android 14+ requires. -->
    <service android:name="androidx.work.impl.foreground.SystemForegroundService" android:foregroundServiceType="dataSync"
             android:exported="false" tools:node="merge" />
  </application>
</manifest>
