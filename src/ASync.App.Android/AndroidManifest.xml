<?xml version="1.0" encoding="utf-8"?>
<!-- The rest (application, activities, the async://pair intent filter, the automation and push receivers) comes from the attributes in code. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Only for scanning the web UI's QR code; the app works without a camera. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera.any" android:required="false" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Background work (M4-2): WorkManager's foreground service while transfers run (type dataSync), and the system's
       question whether ASync may ignore battery optimisation (an APK outside Google Play may ask). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- Folders anywhere on the phone, including a volume's root and Download, which the system's folder picker refuses
       (AndroidStorage): "All files access" on Android 11+, the storage permission with legacy storage on 8–10. The APK is
       distributed outside Google Play, whose policy restricts MANAGE_EXTERNAL_STORAGE. -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
  <!-- Before Android 13 the storage permission is also what reads photos and videos (Photos folders, task 19). -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <!-- Photos folders (task 19): photos and videos on Android 13+, Android 14's "Select photos" (partial access), and the location
       inside the originals (without it MediaStore removes it from what ASync reads). -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
  <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
  <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
  <!-- Android 11+ package visibility: find installed UnifiedPush distributors (ntfy, …). -->
  <queries>
    <intent>
      <action android:name="org.unifiedpush.android.distributor.REGISTER" />
    </intent>
  </queries>
  <application android:requestLegacyExternalStorage="true">
    <!-- ASync's folders in the Files app and document pickers (AsyncDocumentsProvider). Exported only as Android requires
         for a documents provider: callers need MANAGE_DOCUMENTS, which only the system's DocumentsUI holds; other apps get
         single-document grants (grantUriPermissions) when the person picks a file there. -->
    <provider android:name="ua.pp.chds.async.AsyncDocumentsProvider" android:authorities="ua.pp.chds.async.documents"
              android:exported="true" android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
      <intent-filter>
        <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
      </intent-filter>
    </provider>
    <!-- WorkManager's own foreground service, declared with the type Android 14+ requires. -->
    <service android:name="androidx.work.impl.foreground.SystemForegroundService" android:foregroundServiceType="dataSync"
             android:exported="false" tools:node="merge" />
  </application>
</manifest>
