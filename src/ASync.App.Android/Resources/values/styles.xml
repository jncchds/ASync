<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- The web UI's light tokens (Bg #faf5fb): the window behind Avalonia's view and the system bars. -->
  <color name="async_bg">#faf5fb</color>
  <color name="async_surface">#ffffff</color>
  <color name="async_accent">#a21caf</color>
  <style name="ASyncTheme" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="android:windowBackground">@color/async_bg</item>
    <item name="android:statusBarColor">@color/async_surface</item>
    <item name="android:navigationBarColor">@color/async_bg</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="colorAccent">@color/async_accent</item>
    <item name="colorPrimary">@color/async_accent</item>
  </style>
  <style name="ASyncScannerTheme" parent="Theme.AppCompat.NoActionBar">
    <item name="android:windowBackground">@android:color/black</item>
    <item name="android:windowFullscreen">true</item>
    <item name="colorAccent">@color/async_accent</item>
  </style>
</resources>
