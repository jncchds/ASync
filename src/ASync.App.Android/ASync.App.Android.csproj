<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Android head (M4): the shared ASync.App views and view models in one activity, with the sync agent running in
    the app's own process (no separate service: AgentRuntime behind InProcessAgentConnector). Platform parts: the
    device key in the Android Keystore, the store's secrets sealed with a Keystore AES key, folders as Storage Access
    Framework trees (content URIs), the QR scanner (camera + ZXing.Net, no Google Play services), async://pair links.
    Not in ASync.slnx: it needs the `android` workload (`dotnet workload install android`); build it with
    scripts/package-android.sh or `dotnet build src/ASync.App.Android`.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>ASync.App.Android</RootNamespace>
    <AssemblyName>ASync.App.Android</AssemblyName>
    <ApplicationId>ua.pp.chds.async</ApplicationId>
    <ApplicationTitle>ASync</ApplicationTitle>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- versionCode: major*10000 + minor*100 + patch (0.1.4 → 104), from VERSION like everything else. -->
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse('$(Version)').Major), 10000)), $([MSBuild]::Multiply($([System.Version]::Parse('$(Version)').Minor), 100)))), $([System.Version]::Parse('$(Version)').Build)))</ApplicationVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AndroidPackageFormats Condition="'$(AndroidPackageFormats)' == ''">apk</AndroidPackageFormats>
    <AndroidPackageFormats>$([MSBuild]::Unescape($(AndroidPackageFormats.Replace(',', ';'))))</AndroidPackageFormats>
    <!-- One APK for the phones and emulators there are: arm64 phones, 32-bit ARM ones (armeabi-v7a: budget phones and Android Go
         editions run Android in 32-bit mode, even on 64-bit chips; without it they say "not compatible"), x86_64 emulators and
         Chromebooks. 32-bit x86 is left out: no phone of Android 8 or later uses it. -->
    <!-- AndroidAbis=android-x64 builds only one (the emulator), quicker; commas between several on the command line. Setting
         RuntimeIdentifiers there instead would reach the libraries too. -->
    <AndroidAbis Condition="'$(AndroidAbis)' == ''">android-arm64;android-arm;android-x64</AndroidAbis>
    <RuntimeIdentifiers>$([MSBuild]::Unescape($(AndroidAbis.Replace(',', ';'))))</RuntimeIdentifiers>
    <!-- Without this, the SDK adds the build machine's RID (linux-x64) to RuntimeIdentifiers of a trimmed Release build and
         asks for a Mono runtime pack of it that does not exist (NU1102), then for an inner build Android cannot do. -->
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
    <!-- The client library and the engine serialize their state by reflection (see AGENTS.md "Installers and updates"):
         trimming only the framework keeps them working; System.Text.Json's reflection stays on. -->
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- The engine's crypto and sockets are .NET's own; Java's HTTP stack would also work but adds nothing here. -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <AndroidUseAapt2>true</AndroidUseAapt2>
  </PropertyGroup>

  <!-- Signing: a release keystore from CI secrets when there is one (ASYNC_ANDROID_KEYSTORE…), else the debug keystore. -->
  <PropertyGroup Condition="'$(ASYNC_ANDROID_KEYSTORE)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(ASYNC_ANDROID_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(ASYNC_ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:ASYNC_ANDROID_STORE_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:ASYNC_ANDROID_KEY_PASSWORD</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <!-- The local tree contract of the unit tests, run against the SAF tree on a device (automation "selftest"). -->
    <Compile Include="..\ASync.Tests\Local\LocalTreeContract.cs" Link="Tests\LocalTreeContract.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="ZXing.Net" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ASync.App\ASync.App.csproj" />
    <ProjectReference Include="..\ASync.Agent\ASync.Agent.csproj" />
  </ItemGroup>
</Project>
