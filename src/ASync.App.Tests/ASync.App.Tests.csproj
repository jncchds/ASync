<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The app's tests: view models against a fake agent (no Avalonia), and the views in Avalonia.Headless (real layout and
    rendering with Skia, no display). xunit v3, separate from ASync.Tests (xunit v2), because Avalonia.Headless.XUnit 12
    is built on v3.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The phone's browse scope is pure C# over IStorageAccess: tested here, built into the Android head. -->
    <Compile Include="..\ASync.App.Android\PhoneBrowseScope.cs" Link="Linked\PhoneBrowseScope.cs" />
    <!-- The iOS head's plain C# (folder locations, bookmark trees, the sealed store, the browse scope, pairing links): tested
         here, built into src/ASync.App.iOS (which only builds on a Mac). -->
    <Compile Include="..\ASync.App.iOS\Shared\*.cs" LinkBase="Linked\iOS" />
    <!-- The File Provider extension's plain C# (identifiers, items, pages, anchors, the change log, the operations, the host):
         tested here, built into src/ASync.App.iOS.FileProvider (task 25). -->
    <Compile Include="..\ASync.App.iOS.FileProvider\Shared\*.cs" LinkBase="Linked\iOS.FileProvider" />
    <!-- The local tree contract, run here against the iOS bookmark tree. -->
    <Compile Include="..\ASync.Tests\Local\LocalTreeContract.cs" Link="Linked\LocalTreeContract.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ASync.App\ASync.App.csproj" />
    <ProjectReference Include="..\ASync.App.Desktop\ASync.App.Desktop.csproj" />
  </ItemGroup>
</Project>
