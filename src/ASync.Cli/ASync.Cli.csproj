<Project Sdk="Microsoft.NET.Sdk">
  <!-- async-cli: the headless agent (enroll, sync, run as a daemon, back up, restore). Docker image async-cli. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>async-cli</AssemblyName>
    <RootNamespace>ASync.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ASync.Client.Core\ASync.Client.Core.csproj" />
    <!-- Offline restore from remote storage: opens S3, WebDAV, SFTP and SMB repositories directly, without a server. -->
    <ProjectReference Include="..\ASync.Storage\ASync.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ASync.Tests" />
  </ItemGroup>
</Project>
